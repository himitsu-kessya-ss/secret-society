.outline2{text-shadow: #cccccc 1px 1px 0px, #cccccc -1px 1px 0px, #cccccc 1px -1px 0px, #cccccc -1px -1px 0px;}
table[border="1"] {
    border-collapse: collapse;
    border-spacing: 0;
    border: 1px solid #4a4a58;
}
table[border="1"] td,
table[border="1"] th {
